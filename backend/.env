# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://automationhub-omega.vercel.app/

# Database
MONGO_URI=mongodb+srv://AutomationHub:895384@cluster0.r1oe9vz.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=Hello_Automation_Hub
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=Welcome_To_Automation_Hub
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=2894259363-8p886s3lc2ehe8djhse8cg9e317g7ted.apps.googleusercontent.com

# Email (OTP) - Nodemailer SMTP
# Left BLANK on purpose — until a real Gmail App Password is set up, leaving
# these empty makes the app print OTP codes to the backend console instead
# of trying (and failing) to send real email with placeholder credentials.
# Once you have a real App Password, fill these in and OTP emails will send for real.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AutomationHub <no-reply@automationhub.dev>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin bootstrap — only used by `npm run seed:admin`, never read at runtime
ADMIN_NAME=Dhirendra Prajapati
ADMIN_EMAIL=prajapatidhirendra005@gmail.com
ADMIN_PASSWORD=Dhirendra@895384

# AI Assistant — optional. Without this set, /api/ai-assistant/ask returns
# a clear "not configured" message instead of failing silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Contact form — where submissions are emailed. Falls back to ADMIN_EMAIL if unset.
CONTACT_EMAIL=prajapatidhirendra005@gmail.com

# Public site URL used to build absolute links in the sitemap (no trailing slash)
SITE_URL=https://automationhub-omega.vercel.app