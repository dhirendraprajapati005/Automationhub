# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/automationhub

# JWT
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email (OTP) - Nodemailer SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="AutomationHub <no-reply@automationhub.dev>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin bootstrap — only used by `npm run seed:admin`, never read at runtime
ADMIN_NAME=Dhirendra Prajapati
ADMIN_EMAIL=admin@automationhub.dev
ADMIN_PASSWORD=change_this_before_running

# AI Assistant — optional. Without this set, /api/ai-assistant/ask returns
# a clear "not configured" message instead of failing silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Contact form — where submissions are emailed. Falls back to ADMIN_EMAIL if unset.
CONTACT_EMAIL=

# Public site URL used to build absolute links in the sitemap (no trailing slash)
SITE_URL=https://automationhub.dev

